{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/load-brain.py 2>/dev/null || python .claude/hooks/load-brain.py 2>/dev/null || py -3 .claude/hooks/load-brain.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/reply-style.py 2>/dev/null || python .claude/hooks/reply-style.py 2>/dev/null || py -3 .claude/hooks/reply-style.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
